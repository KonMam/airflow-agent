# LLM provider — any model supported by LiteLLM
# Examples: openai/gpt-4o, anthropic/claude-sonnet-4-6, gemini/gemini-2.0-flash, ollama/llama3.1
LLM_MODEL=openai/gpt-4o
LLM_API_KEY=your-api-key-here
LLM_MAX_TOKENS=1024
# Fallback models tried in order when primary hits rate limits (comma-separated)
# Local Ollama model as last fallback: brew install ollama && ollama pull qwen2.5:7b && ollama serve
# LLM_FALLBACK_MODELS=groq/llama-3.1-8b-instant,ollama/qwen2.5:7b
LLM_FALLBACK_THRESHOLD_S=60   # switch model if wait > this many seconds

# Embedding model (optional — leave empty to use local sentence-transformers)
# EMBED_MODEL=openai/text-embedding-3-small

# Airflow connection
AIRFLOW_URL=http://localhost:8080
AIRFLOW_API_VERSION=v1   # v1 for Airflow 2, v2 for Airflow 3
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# Poller settings
POLL_INTERVAL=30         # seconds between checks
# POLL_DAG_IDS=dag1,dag2  # optional: comma-separated DAG IDs to watch (empty = all)

# Storage
CHROMA_PATH=.chroma      # path for ChromaDB persistence
